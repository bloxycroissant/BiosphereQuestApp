{
  "expo": {
    "name": "Biosphere Quest",
    "slug": "biosphere-quest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/BiosphereQuestAssets/Biosphere Quest Logo.png",
    "scheme": "biospherequest",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "icon": "./assets/BiosphereQuestAssets/Biosphere Quest Logo.png"
    },
    "android": {
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#091426",
        "foregroundImage": "./assets/BiosphereQuestAssets/Biosphere Quest Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.biosphere.quest"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/BiosphereQuestAssets/Biosphere Quest Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#091426",
          "image": "./assets/BiosphereQuestAssets/Biosphere Quest Logo.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#091426",
            "image": "./assets/BiosphereQuestAssets/Biosphere Quest Logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eeb9f2b0-3e50-4840-8b71-12da72b1fef1"
      }
    },
    "owner": "bloxycroissant"
  }
}
